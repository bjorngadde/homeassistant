{
  "name": "homeassistant-cards",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Custom Lovelace cards for a Home Assistant house dashboard (phone card and hall wall display).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/scrub-check.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p .",
    "pretest": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs && node test/snapshot.mjs",
    "presnapshot:update": "node scripts/build.mjs",
    "snapshot:update": "node test/snapshot.mjs --update",
    "equiv": "node test/equiv.mjs",
    "test:render": "node test/render-equivalence.mjs",
    "prepreview": "node scripts/build.mjs",
    "preview": "node test/preview.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1",
    "typescript": "7.0.2"
  }
}
